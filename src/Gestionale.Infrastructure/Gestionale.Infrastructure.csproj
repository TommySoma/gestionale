<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Gestionale.Application\Gestionale.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gestionale.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Testi dei documenti generati: file di traduzione, mai stringhe nel codice. -->
    <EmbeddedResource Update="Documenti\TestiDocumenti.resx"
                      StronglyTypedLanguage="C#"
                      StronglyTypedNamespace="Gestionale.Infrastructure.Documenti"
                      StronglyTypedClassName="TestiDocumenti"
                      StronglyTypedFileName="$(IntermediateOutputPath)TestiDocumenti.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sicurezza/password-note.txt" LogicalName="Gestionale.Infrastructure.Sicurezza.password-note.txt" />
    <!-- Inter (SIL Open Font License 1.1, vedi Documenti/Caratteri/OFL-Inter.txt): stesso PDF su ogni sistema. -->
    <EmbeddedResource Include="Documenti/Caratteri/Inter-Regular.ttf" LogicalName="Gestionale.Infrastructure.Documenti.Inter-Regular.ttf" />
    <EmbeddedResource Include="Documenti/Caratteri/Inter-SemiBold.ttf" LogicalName="Gestionale.Infrastructure.Documenti.Inter-SemiBold.ttf" />
  </ItemGroup>
</Project>
