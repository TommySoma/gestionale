<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:v="using:Gestionale.Desktop.Views"
             x:Class="Gestionale.Desktop.App"
             RequestedThemeVariant="Default">
  <!-- Il tema segue il sistema; l'utente può fissarlo dal menu utente (Servizi/PreferenzaTema). -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:AccessoViewModel"><v:AccessoView /></DataTemplate>
    <DataTemplate DataType="vm:VerificaMfaViewModel"><v:VerificaMfaView /></DataTemplate>
    <DataTemplate DataType="vm:ConfiguraMfaViewModel"><v:ConfiguraMfaView /></DataTemplate>
    <DataTemplate DataType="vm:CodiciRecuperoViewModel"><v:CodiciRecuperoView /></DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel"><v:ShellView /></DataTemplate>
    <DataTemplate DataType="vm:ClientiViewModel"><v:ClientiView /></DataTemplate>
    <DataTemplate DataType="vm:SchedaClienteViewModel"><v:SchedaClienteView /></DataTemplate>
    <DataTemplate DataType="vm:EditorClienteViewModel"><v:EditorClienteView /></DataTemplate>
    <DataTemplate DataType="vm:EditorSedeViewModel"><v:EditorSedeView /></DataTemplate>
    <DataTemplate DataType="vm:EditorContattoViewModel"><v:EditorContattoView /></DataTemplate>
    <DataTemplate DataType="vm:EditorConsensoViewModel"><v:EditorConsensoView /></DataTemplate>
    <DataTemplate DataType="vm:ImpiantiViewModel"><v:ImpiantiView /></DataTemplate>
    <DataTemplate DataType="vm:SchedaImpiantoViewModel"><v:SchedaImpiantoView /></DataTemplate>
    <DataTemplate DataType="vm:EditorImpiantoViewModel"><v:EditorImpiantoView /></DataTemplate>
    <DataTemplate DataType="vm:EditorGeneratoreViewModel"><v:EditorGeneratoreView /></DataTemplate>
    <DataTemplate DataType="vm:EditorRiferimentoCatastoViewModel"><v:EditorRiferimentoCatastoView /></DataTemplate>
    <DataTemplate DataType="vm:CalendarioViewModel"><v:CalendarioView /></DataTemplate>
    <DataTemplate DataType="vm:SchedaInterventoViewModel"><v:SchedaInterventoView /></DataTemplate>
    <DataTemplate DataType="vm:EditorInterventoViewModel"><v:EditorInterventoView /></DataTemplate>
    <DataTemplate DataType="vm:ChiusuraInterventoViewModel"><v:ChiusuraInterventoView /></DataTemplate>
    <DataTemplate DataType="vm:AnnullamentoInterventoViewModel"><v:AnnullamentoInterventoView /></DataTemplate>
    <DataTemplate DataType="vm:ScadenzeViewModel"><v:ScadenzeView /></DataTemplate>
    <DataTemplate DataType="vm:RichiamoViewModel"><v:RichiamoView /></DataTemplate>
    <DataTemplate DataType="vm:DataScadenzaViewModel"><v:DataScadenzaView /></DataTemplate>
    <DataTemplate DataType="vm:ListinoViewModel"><v:ListinoView /></DataTemplate>
    <DataTemplate DataType="vm:EditorVoceViewModel"><v:EditorVoceView /></DataTemplate>
    <DataTemplate DataType="vm:PrezzoVoceViewModel"><v:PrezzoVoceView /></DataTemplate>
    <DataTemplate DataType="vm:PreventiviViewModel"><v:PreventiviView /></DataTemplate>
    <DataTemplate DataType="vm:SchedaPreventivoViewModel"><v:SchedaPreventivoView /></DataTemplate>
    <DataTemplate DataType="vm:EditorPreventivoViewModel"><v:EditorPreventivoView /></DataTemplate>
    <DataTemplate DataType="vm:AnnullamentoPreventivoViewModel"><v:AnnullamentoPreventivoView /></DataTemplate>
    <DataTemplate DataType="vm:InterventoDaPreventivoViewModel"><v:InterventoDaPreventivoView /></DataTemplate>
    <DataTemplate DataType="vm:ConfermaViewModel"><v:ConfermaView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Gestionale.Desktop/Tema/Stili.axaml" />
  </Application.Styles>
</Application>
