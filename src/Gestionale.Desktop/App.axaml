<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:v="using:Gestionale.Desktop.Views"
             x:Class="Gestionale.Desktop.App"
             RequestedThemeVariant="Default">
  <!-- Il tema segue il sistema; l'utente può fissarlo dal menu utente (Servizi/PreferenzaTema). -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:AccessoViewModel"><v:AccessoView /></DataTemplate>
    <DataTemplate DataType="vm:VerificaMfaViewModel"><v:VerificaMfaView /></DataTemplate>
    <DataTemplate DataType="vm:ConfiguraMfaViewModel"><v:ConfiguraMfaView /></DataTemplate>
    <DataTemplate DataType="vm:CodiciRecuperoViewModel"><v:CodiciRecuperoView /></DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel"><v:ShellView /></DataTemplate>
    <DataTemplate DataType="vm:ClientiViewModel"><v:ClientiView /></DataTemplate>
    <DataTemplate DataType="vm:SchedaClienteViewModel"><v:SchedaClienteView /></DataTemplate>
    <DataTemplate DataType="vm:EditorClienteViewModel"><v:EditorClienteView /></DataTemplate>
    <DataTemplate DataType="vm:EditorSedeViewModel"><v:EditorSedeView /></DataTemplate>
    <DataTemplate DataType="vm:EditorContattoViewModel"><v:EditorContattoView /></DataTemplate>
    <DataTemplate DataType="vm:EditorConsensoViewModel"><v:EditorConsensoView /></DataTemplate>
    <DataTemplate DataType="vm:ConfermaViewModel"><v:ConfermaView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Gestionale.Desktop/Tema/Stili.axaml" />
  </Application.Styles>
</Application>
