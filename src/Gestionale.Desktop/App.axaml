<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gestionale.Desktop.App"
             RequestedThemeVariant="Default">
  <!-- "Default" segue il tema chiaro o scuro del sistema. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
