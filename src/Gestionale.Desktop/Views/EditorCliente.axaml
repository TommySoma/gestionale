<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.EditorClienteView"
             x:DataType="vm:EditorClienteViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <TextBlock Text="{Binding Titolo}" FontSize="20" FontWeight="Bold" />
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" IsDefault="True" Content="{x:Static r:Testi.SalvaCliente}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24" Spacing="20">
        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <DockPanel>
            <Path Classes="icona" Data="{StaticResource IconaAvviso}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Errore}" />
          </DockPanel>
        </Border>

        <StackPanel>
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.TipoCliente}" />
          <ComboBox ItemsSource="{Binding Tipi}" SelectedItem="{Binding Tipo}" AutomationProperties.Name="{x:Static r:Testi.TipoCliente}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding Privato}">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Nome}" />
            <TextBox Text="{Binding Nome}" AutomationProperties.Name="{x:Static r:Testi.Nome}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Cognome}" />
            <TextBox Text="{Binding Cognome}" AutomationProperties.Name="{x:Static r:Testi.Cognome}" />
          </StackPanel>
        </Grid>

        <StackPanel IsVisible="{Binding ConDenominazione}">
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Denominazione}" />
          <TextBox Text="{Binding Denominazione}" AutomationProperties.Name="{x:Static r:Testi.Denominazione}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.CodiceFiscale}" />
            <TextBox Text="{Binding CodiceFiscale}" Classes="codice" AutomationProperties.Name="{x:Static r:Testi.CodiceFiscale}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="etichetta">
              <Run Text="{x:Static r:Testi.PartitaIva}" />
              <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{StaticResource TestoSecondario}" />
            </TextBlock>
            <TextBox Text="{Binding PartitaIva}" AutomationProperties.Name="{x:Static r:Testi.PartitaIva}" />
          </StackPanel>
        </Grid>

        <StackPanel>
          <TextBlock Classes="etichetta">
            <Run Text="{x:Static r:Testi.Pec}" />
            <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{StaticResource TestoSecondario}" />
          </TextBlock>
          <TextBox Text="{Binding Pec}" AutomationProperties.Name="{x:Static r:Testi.Pec}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Note}" />
          <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="{x:Static r:Testi.Note}" />
        </StackPanel>

        <TextBlock Classes="secondario" FontSize="13" IsVisible="{Binding Nuovo}" Text="{x:Static r:Testi.DopoSalvataggio}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
