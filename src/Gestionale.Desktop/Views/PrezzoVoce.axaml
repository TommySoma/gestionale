<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.PrezzoVoceView"
             x:DataType="vm:PrezzoVoceViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static r:Testi.TitoloNuovoPrezzo}" FontSize="20" FontWeight="Bold" />
        <TextBlock Classes="secondario" FontSize="14" Text="{Binding Descrizione}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" IsDefault="True" Content="{x:Static r:Testi.Salva}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24" Spacing="20">
      <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
        <DockPanel>
          <Path Classes="icona" Data="{StaticResource IconaAvviso}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding Errore}" />
        </DockPanel>
      </Border>
      <StackPanel>
        <TextBlock Classes="etichetta" Text="{x:Static r:Testi.PrezzoAttuale}" />
        <TextBlock FontSize="14" Text="{Binding PrezzoAttuale}" />
      </StackPanel>
      <TextBlock FontSize="14" TextWrapping="Wrap" Text="{x:Static r:Testi.SpiegazioneNuovoPrezzo}" />
      <Grid ColumnDefinitions="*,16,*">
        <StackPanel Grid.Column="0">
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.NuovoPrezzoEuro}" />
          <TextBox Text="{Binding Prezzo}" AutomationProperties.Name="{x:Static r:Testi.NuovoPrezzoEuro}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.ValidoDal}" />
          <CalendarDatePicker SelectedDate="{Binding ValidoDal}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.ValidoDal}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </DockPanel>
</UserControl>
