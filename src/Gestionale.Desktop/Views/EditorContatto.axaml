<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.EditorContattoView"
             x:DataType="vm:EditorContattoViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <TextBlock Text="{x:Static r:Testi.TitoloNuovoContatto}" FontSize="20" FontWeight="Bold" />
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" IsDefault="True" Content="{x:Static r:Testi.SalvaContatto}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24" Spacing="20">
      <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
        <TextBlock Text="{Binding Errore}" />
      </Border>
      <Grid ColumnDefinitions="*,16,2*">
        <StackPanel Grid.Column="0">
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.TipoContatto}" />
          <ComboBox ItemsSource="{Binding Tipi}" SelectedItem="{Binding Tipo}" AutomationProperties.Name="{x:Static r:Testi.TipoContatto}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Valore}" />
          <TextBox Text="{Binding Valore}" AutomationProperties.Name="{x:Static r:Testi.Valore}" />
        </StackPanel>
      </Grid>
      <StackPanel>
        <TextBlock Classes="etichetta">
          <Run Text="{x:Static r:Testi.Etichetta}" />
          <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{DynamicResource TestoSecondario}" />
        </TextBlock>
        <TextBox Text="{Binding Etichetta}" PlaceholderText="{x:Static r:Testi.EtichettaEsempio}" AutomationProperties.Name="{x:Static r:Testi.Etichetta}" />
      </StackPanel>
      <CheckBox IsChecked="{Binding Principale}" Content="{x:Static r:Testi.ContattoPrincipale}" />
    </StackPanel>
  </DockPanel>
</UserControl>
