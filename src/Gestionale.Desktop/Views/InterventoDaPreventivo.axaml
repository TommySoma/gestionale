<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.InterventoDaPreventivoView"
             x:DataType="vm:InterventoDaPreventivoViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static r:Testi.TitoloGeneraIntervento}" FontSize="20" FontWeight="Bold" />
        <TextBlock Classes="secondario" FontSize="14" Text="{Binding Descrizione}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" IsDefault="True" Content="{x:Static r:Testi.GeneraIntervento}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24" Spacing="20">
      <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
        <DockPanel>
          <Path Classes="icona" Data="{StaticResource IconaAvviso}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding Errore}" />
        </DockPanel>
      </Border>
      <Border Classes="avvisoAttenzione" IsVisible="{Binding SenzaImpianto}">
        <DockPanel>
          <Path Classes="icona" Data="{StaticResource IconaInfo}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
          <TextBlock Text="{x:Static r:Testi.AvvisoPreventivoSenzaImpianto}" />
        </DockPanel>
      </Border>
      <TextBlock FontSize="14" TextWrapping="Wrap" Text="{x:Static r:Testi.SpiegazioneGeneraIntervento}" />
      <StackPanel>
        <TextBlock Classes="etichetta" Text="{x:Static r:Testi.TipoIntervento}" />
        <ComboBox ItemsSource="{Binding Tipi}" SelectedItem="{Binding Tipo}" HorizontalAlignment="Stretch"
                  PlaceholderText="{x:Static r:Testi.ScegliTipoIntervento}" AutomationProperties.Name="{x:Static r:Testi.TipoIntervento}" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</UserControl>
