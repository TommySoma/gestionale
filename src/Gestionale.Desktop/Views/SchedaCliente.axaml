<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.SchedaClienteView"
             x:DataType="vm:SchedaClienteViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">
      <StackPanel Spacing="12">
        <Button Classes="collegamento" HorizontalAlignment="Left" Content="{x:Static r:Testi.TornaAiClienti}" Command="{Binding IndietroCommand}" />
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button Classes="secondario" Content="{x:Static r:Testi.Modifica}" Command="{Binding ModificaCommand}" IsVisible="{Binding PuoModificare}" />
            <Button Classes="secondario" Content="{x:Static r:Testi.Elimina}" Foreground="{DynamicResource Errore}" Command="{Binding EliminaCommand}" IsVisible="{Binding PuoModificare}" />
            <Button Classes="secondario" Content="{x:Static r:Testi.Anonimizza}" Foreground="{DynamicResource Errore}" Command="{Binding AnonimizzaCommand}" IsVisible="{Binding PuoAnonimizzare}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="titolo2" Text="{Binding Nome}" />
            <Border Classes="distintivo">
              <TextBlock Text="{Binding Tipo}" />
            </Border>
          </StackPanel>
        </DockPanel>
        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <TextBlock Text="{Binding Errore}" />
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="2*,20,*">
        <StackPanel Grid.Column="0" Spacing="20">
          <!-- Sedi -->
          <Border Classes="scheda">
            <StackPanel>
              <DockPanel Margin="20,12">
                <Button DockPanel.Dock="Right" Classes="collegamento" Content="{x:Static r:Testi.AggiungiSede}" IsVisible="{Binding PuoModificare}" Command="{Binding AggiungiSedeCommand}" />
                <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.Sedi}" VerticalAlignment="Center" />
              </DockPanel>
              <Border Height="1" Background="{DynamicResource Divisore}" />
              <TextBlock Classes="secondario" FontSize="14" Margin="20,16" IsVisible="{Binding SenzaSedi}" Text="{x:Static r:Testi.NessunaSede}" />
              <ItemsControl ItemsSource="{Binding Sedi}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RigaSede">
                    <DockPanel Margin="20,16">
                      <Button DockPanel.Dock="Right" Classes="collegamento" Foreground="{DynamicResource Errore}" Content="{x:Static r:Testi.Elimina}"
                              IsVisible="{Binding $parent[UserControl].((vm:SchedaClienteViewModel)DataContext).PuoModificare}"
                              Command="{Binding $parent[UserControl].((vm:SchedaClienteViewModel)DataContext).EliminaSedeCommand}" CommandParameter="{Binding}" />
                      <Path DockPanel.Dock="Left" Classes="icona" Data="{StaticResource IconaLuogo}" VerticalAlignment="Top" Margin="0,2,16,0" />
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Indirizzo}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Classes="secondario" FontSize="14" Text="{Binding Note}" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Spacing="2" Margin="0,6,0,0" IsVisible="{Binding $parent[UserControl].((vm:SchedaClienteViewModel)DataContext).VedeImpianti}">
                          <TextBlock Classes="secondario" FontSize="14" Text="{x:Static r:Testi.NessunImpiantoSede}" IsVisible="{Binding SenzaImpianti}" />
                          <ItemsControl ItemsSource="{Binding Impianti}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:RigaImpiantoSede">
                                <Button Classes="collegamento" HorizontalAlignment="Left" Padding="0,2"
                                        Command="{Binding $parent[UserControl].((vm:SchedaClienteViewModel)DataContext).ApriImpiantoCommand}" CommandParameter="{Binding}">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Tipo}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Dettaglio}" FontSize="14" Foreground="{DynamicResource TestoSecondario}" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Classes="collegamento" HorizontalAlignment="Left" Padding="0,2" Content="{x:Static r:Testi.AggiungiImpianto}"
                                  IsVisible="{Binding $parent[UserControl].((vm:SchedaClienteViewModel)DataContext).PuoAggiungereImpianti}"
                                  Command="{Binding $parent[UserControl].((vm:SchedaClienteViewModel)DataContext).AggiungiImpiantoCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Contatti -->
          <Border Classes="scheda">
            <StackPanel>
              <DockPanel Margin="20,12">
                <Button DockPanel.Dock="Right" Classes="collegamento" Content="{x:Static r:Testi.AggiungiContatto}" IsVisible="{Binding PuoModificare}" Command="{Binding AggiungiContattoCommand}" />
                <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.Contatti}" VerticalAlignment="Center" />
              </DockPanel>
              <Border Height="1" Background="{DynamicResource Divisore}" />
              <TextBlock Classes="secondario" FontSize="14" Margin="20,16" IsVisible="{Binding SenzaContatti}" Text="{x:Static r:Testi.NessunContatto}" />
              <ItemsControl ItemsSource="{Binding Contatti}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RigaContatto">
                    <Border BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="20,10">
                      <Grid ColumnDefinitions="96,*,Auto,Auto,Auto" >
                        <TextBlock Grid.Column="0" Classes="secondario" FontSize="14" Text="{Binding Tipo}" VerticalAlignment="Center" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Valore}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="secondario" FontSize="14" Text="{Binding Etichetta}" VerticalAlignment="Center" Margin="16,0" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" IsVisible="{Binding Principale}" VerticalAlignment="Center">
                          <Path Classes="icona accento" Data="{StaticResource IconaStella}" Width="14" Height="14" Fill="{DynamicResource Accento}" StrokeThickness="1" />
                          <TextBlock Text="{x:Static r:Testi.Principale}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accento}" />
                        </StackPanel>
                        <Button Grid.Column="4" Classes="collegamento" Foreground="{DynamicResource Errore}" Content="{x:Static r:Testi.Elimina}" Margin="8,0,0,0"
                                IsVisible="{Binding $parent[UserControl].((vm:SchedaClienteViewModel)DataContext).PuoModificare}"
                                Command="{Binding $parent[UserControl].((vm:SchedaClienteViewModel)DataContext).EliminaContattoCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="20">
          <!-- Dati fiscali -->
          <Border Classes="scheda" Padding="20,16">
            <StackPanel Spacing="12">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.DatiFiscali}" />
              <StackPanel>
                <TextBlock Classes="secondario" FontSize="12" Text="{x:Static r:Testi.CodiceFiscale}" />
                <SelectableTextBlock Classes="codice" FontSize="14" Text="{Binding CodiceFiscale}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="secondario" FontSize="12" Text="{x:Static r:Testi.PartitaIva}" />
                <SelectableTextBlock Classes="codice" FontSize="14" Text="{Binding PartitaIva}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="secondario" FontSize="12" Text="{x:Static r:Testi.Pec}" />
                <SelectableTextBlock FontSize="14" Text="{Binding Pec}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Consensi: stato sempre con icona e testo, mai solo colore. -->
          <Border Classes="scheda" Padding="20,16">
            <StackPanel Spacing="12">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.ConsensiPrivacy}" />
              <TextBlock Classes="secondario" FontSize="14" IsVisible="{Binding SenzaConsensi}" Text="{x:Static r:Testi.NessunConsenso}" />
              <ItemsControl ItemsSource="{Binding Consensi}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RigaConsenso">
                    <DockPanel Margin="0,0,0,12">
                      <Panel DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top">
                        <Path Classes="icona successo" Data="{StaticResource IconaOk}" StrokeThickness="2" IsVisible="{Binding Concesso}" />
                        <Path Classes="icona errore" Data="{StaticResource IconaNo}" StrokeThickness="2" IsVisible="{Binding !Concesso}" />
                      </Panel>
                      <StackPanel>
                        <TextBlock Text="{Binding Finalita}" FontSize="14" FontWeight="SemiBold" />
                        <Panel>
                          <TextBlock Text="{Binding Stato}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Successo}" IsVisible="{Binding Concesso}" />
                          <TextBlock Text="{Binding Stato}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Errore}" IsVisible="{Binding !Concesso}" />
                        </Panel>
                        <TextBlock Classes="secondario" FontSize="13" Text="{Binding Dettaglio}" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="secondario" HorizontalAlignment="Left" Content="{x:Static r:Testi.RegistraConsenso}"
                      IsVisible="{Binding PuoModificare}" Command="{Binding RegistraConsensoCommand}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
