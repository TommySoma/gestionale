<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.ScadenzeView"
             x:DataType="vm:ScadenzeViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primario" VerticalAlignment="Bottom" IsVisible="{Binding PuoInviarePromemoria}"
                Content="{Binding TestoInviaPromemoria}" Command="{Binding InviaPromemoriaCommand}" />
        <StackPanel>
          <TextBlock Classes="titolo2" Text="{x:Static r:Testi.ScadenzeTitolo}" />
          <TextBlock Classes="secondario" FontSize="14" Margin="0,4,0,0" Text="{Binding Conteggio}" />
        </StackPanel>
      </DockPanel>

      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.FiltroTutteLeScadenze}" IsChecked="{Binding TipoTutti}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.FiltroManutenzioni}" IsChecked="{Binding TipoManutenzioni}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.FiltroControlli}" IsChecked="{Binding TipoControlli}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="secondario" FontSize="14" VerticalAlignment="Center" Text="{x:Static r:Testi.ScadutoEEntro}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.Entro30Giorni}" IsChecked="{Binding Entro30}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.Entro60Giorni}" IsChecked="{Binding Entro60}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.Entro90Giorni}" IsChecked="{Binding Entro90}" />
        </StackPanel>
      </DockPanel>

      <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
        <TextBlock Text="{Binding Errore}" />
      </Border>
      <Border Classes="avvisoSuccesso" IsVisible="{Binding HaAvviso}">
        <TextBlock Text="{Binding Avviso}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="avvisoErrore" IsVisible="{Binding HaScadute}">
        <DockPanel>
          <Path Classes="icona" Data="{StaticResource IconaAvviso}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding AvvisoScadute}" />
        </DockPanel>
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondario" Content="{x:Static r:Testi.Precedente}" IsEnabled="{Binding PuoPrecedente}" Command="{Binding PrecedenteCommand}" />
        <Button Classes="secondario" Content="{x:Static r:Testi.Successiva}" IsEnabled="{Binding PuoSuccessiva}" Command="{Binding SuccessivaCommand}" />
      </StackPanel>
      <TextBlock Classes="secondario" FontSize="14" VerticalAlignment="Center" Text="{Binding Intervallo}" />
    </DockPanel>

    <Border Classes="scheda">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="200,3*,1.6*,1.4*,2.4*,Auto" Margin="16,12">
          <TextBlock Grid.Column="0" Margin="32,0,0,0" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColUrgenza}" />
          <TextBlock Grid.Column="1" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColCliente}" />
          <TextBlock Grid.Column="2" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColTipo}" />
          <TextBlock Grid.Column="3" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColData}" />
          <TextBlock Grid.Column="4" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColRichiamo}" />
          <Border Grid.Column="5" Width="196" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Bordo}" />
        <Panel>
          <TextBlock Classes="secondario" FontSize="14" Margin="16,24" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding Vuoto}" Text="{x:Static r:Testi.NessunaScadenza}" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Righe}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RigaScadenza">
                  <Border BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid ColumnDefinitions="200,3*,1.6*,1.4*,2.4*,Auto">
                      <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Selezione.Scelta}"
                                IsVisible="{Binding $parent[UserControl].((vm:ScadenzeViewModel)DataContext).PuoInviarePromemoria}"
                                AutomationProperties.Name="{x:Static r:Testi.ScegliPerPromemoria}" />
                      <Border Grid.Column="0" Margin="32,0,0,0" Classes="distintivo" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Classes.scaduta="{Binding Scaduta}" Classes.inScadenza="{Binding InScadenza}" Classes.inRegola="{Binding InRegola}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Classes="icona" Data="{StaticResource IconaAvviso}" Width="14" Height="14" IsVisible="{Binding Scaduta}" />
                          <Path Classes="icona" Data="{StaticResource IconaInfo}" Width="14" Height="14" IsVisible="{Binding InScadenza}" />
                          <Path Classes="icona" Data="{StaticResource IconaOk}" Width="14" Height="14" IsVisible="{Binding InRegola}" />
                          <TextBlock Text="{Binding Urgenza}" />
                        </StackPanel>
                      </Border>
                      <Button Grid.Column="1" Background="Transparent" Padding="0,0,12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Command="{Binding $parent[UserControl].((vm:ScadenzeViewModel)DataContext).ApriCommand}" CommandParameter="{Binding}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Cliente}" FontWeight="SemiBold" Foreground="{DynamicResource Accento}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="secondario" FontSize="13" Text="{Binding Indirizzo}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                      <TextBlock Grid.Column="2" Text="{Binding Tipo}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                      <TextBlock Grid.Column="3" Text="{Binding Data}" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Richiamo}" FontSize="14" />
                        <TextBlock Classes="secondario" FontSize="13" Text="{Binding UltimoRichiamo}" IsVisible="{Binding HaUltimoRichiamo}" TextWrapping="Wrap" />
                        <SelectableTextBlock Classes="secondario" FontSize="13" Text="{Binding Telefono}" IsVisible="{Binding Telefono, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="5" Width="196" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  IsVisible="{Binding $parent[UserControl].((vm:ScadenzeViewModel)DataContext).GestisceScadenze}">
                        <Button Classes="collegamento" Content="{x:Static r:Testi.RegistraRichiamo}"
                                Command="{Binding $parent[UserControl].((vm:ScadenzeViewModel)DataContext).RegistraRichiamoCommand}" CommandParameter="{Binding}" />
                        <Button Classes="collegamento" Content="{x:Static r:Testi.CorreggiData}"
                                Command="{Binding $parent[UserControl].((vm:ScadenzeViewModel)DataContext).CorreggiDataCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
