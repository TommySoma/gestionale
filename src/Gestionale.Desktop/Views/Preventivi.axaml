<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.PreventiviView"
             x:DataType="vm:PreventiviViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primario" VerticalAlignment="Center" Content="{x:Static r:Testi.NuovoPreventivo}"
                Command="{Binding NuovoCommand}" IsVisible="{Binding GestiscePreventivi}" />
        <StackPanel>
          <TextBlock Classes="titolo2" Text="{x:Static r:Testi.PreventiviTitolo}" />
          <TextBlock Classes="secondario" FontSize="14" Margin="0,4,0,0" Text="{Binding Conteggio}" />
        </StackPanel>
      </DockPanel>

      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.FiltroTutti}" IsChecked="{Binding FiltroTutti}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.FiltroBozze}" IsChecked="{Binding FiltroBozze}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.FiltroEmessi}" IsChecked="{Binding FiltroEmessi}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.FiltroScaduti}" IsChecked="{Binding FiltroScaduti}" />
          <ToggleButton Classes="filtro" Content="{x:Static r:Testi.FiltroAccettati}" IsChecked="{Binding FiltroAccettati}" />
        </StackPanel>
        <TextBox Text="{Binding Testo}" MaxWidth="420" HorizontalAlignment="Left" Margin="0,0,16,0"
                 PlaceholderText="{x:Static r:Testi.CercaPreventivi}" AutomationProperties.Name="{x:Static r:Testi.CercaPreventivi}" />
      </DockPanel>

      <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
        <TextBlock Text="{Binding Errore}" />
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondario" Content="{x:Static r:Testi.Precedente}" IsEnabled="{Binding PuoPrecedente}" Command="{Binding PrecedenteCommand}" />
        <Button Classes="secondario" Content="{x:Static r:Testi.Successiva}" IsEnabled="{Binding PuoSuccessiva}" Command="{Binding SuccessivaCommand}" />
      </StackPanel>
      <TextBlock Classes="secondario" FontSize="14" VerticalAlignment="Center" Text="{Binding Intervallo}" />
    </DockPanel>

    <Border Classes="scheda">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="1.2*,2*,3*,1.6*,1.2*,Auto" Margin="16,12">
          <TextBlock Grid.Column="0" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColNumero}" />
          <TextBlock Grid.Column="1" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColCliente}" />
          <TextBlock Grid.Column="2" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColOggetto}" />
          <TextBlock Grid.Column="3" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColData}" />
          <TextBlock Grid.Column="4" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.Totale}" />
          <TextBlock Grid.Column="5" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColStato}" Width="100" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Bordo}" />
        <Panel>
          <TextBlock Classes="secondario" FontSize="14" Margin="16,24" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding Vuoto}" Text="{x:Static r:Testi.NessunPreventivo}" />
          <ListBox ItemsSource="{Binding Righe}" Background="Transparent" AutomationProperties.Name="{x:Static r:Testi.PreventiviTitolo}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RigaElencoPreventivo">
                <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" MinHeight="44"
                        Command="{Binding $parent[UserControl].((vm:PreventiviViewModel)DataContext).ApriCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="1.2*,2*,3*,1.6*,1.2*,Auto" Margin="4,0">
                    <TextBlock Grid.Column="0" Text="{Binding Numero}" FontWeight="SemiBold" Foreground="{DynamicResource Accento}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Cliente}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Oggetto}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Data}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Totale}" VerticalAlignment="Center" />
                    <Border Grid.Column="5" Classes="distintivo" Classes.inScadenza="{Binding Scaduto}" Width="100" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Path Classes="icona" Data="{StaticResource IconaAvviso}" Width="12" Height="12" IsVisible="{Binding Scaduto}" />
                        <TextBlock Text="{Binding Stato}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
