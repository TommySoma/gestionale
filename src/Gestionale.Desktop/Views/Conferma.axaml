<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.ConfermaView"
             x:DataType="vm:ConfermaViewModel">
  <StackPanel Margin="24" Spacing="20">
    <TextBlock Text="{Binding Titolo}" FontSize="20" FontWeight="Bold" />
    <TextBlock Classes="secondario" FontSize="15" Text="{Binding Messaggio}" />
    <StackPanel IsVisible="{Binding RichiedeParola}">
      <TextBlock Classes="etichetta" Text="{Binding IstruzioneParola}" />
      <TextBox Text="{Binding ParolaScritta}" AutomationProperties.Name="{Binding IstruzioneParola}" />
    </StackPanel>
    <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
      <TextBlock Text="{Binding Errore}" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
      <Button Classes="secondario" IsCancel="True" IsDefault="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
      <Button Classes="pericolo" Content="{Binding Azione}" Command="{Binding SalvaCommand}">
        <Button.IsEnabled>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!InCorso" />
            <Binding Path="PuoConfermare" />
          </MultiBinding>
        </Button.IsEnabled>
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>
