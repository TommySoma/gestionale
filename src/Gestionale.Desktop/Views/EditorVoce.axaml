<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.EditorVoceView"
             x:DataType="vm:EditorVoceViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <TextBlock Text="{Binding Titolo}" FontSize="20" FontWeight="Bold" />
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" IsDefault="True" Content="{x:Static r:Testi.Salva}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24" Spacing="20">
        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <DockPanel>
            <Path Classes="icona" Data="{StaticResource IconaAvviso}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Errore}" />
          </DockPanel>
        </Border>

        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.ColCodice}" />
            <TextBox Text="{Binding Codice}" AutomationProperties.Name="{x:Static r:Testi.ColCodice}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.ColTipo}" />
            <ComboBox ItemsSource="{Binding Tipi}" SelectedItem="{Binding Tipo}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.ColTipo}" />
          </StackPanel>
        </Grid>

        <StackPanel>
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.ColDescrizione}" />
          <TextBox Text="{Binding Descrizione}" AutomationProperties.Name="{x:Static r:Testi.ColDescrizione}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*,16,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Unita}" />
            <TextBox Text="{Binding Unita}" IsEnabled="{Binding !Manodopera}" AutomationProperties.Name="{x:Static r:Testi.Unita}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Iva}" />
            <TextBox Text="{Binding Iva}" AutomationProperties.Name="{x:Static r:Testi.Iva}" />
          </StackPanel>
          <StackPanel Grid.Column="4" IsVisible="{Binding ConPrezzoIniziale}">
            <TextBlock Classes="etichetta">
              <Run Text="{x:Static r:Testi.PrezzoIniziale}" />
              <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{DynamicResource TestoSecondario}" />
            </TextBlock>
            <TextBox Text="{Binding PrezzoIniziale}" AutomationProperties.Name="{x:Static r:Testi.PrezzoIniziale}" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="secondario" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding InModifica}" Text="{x:Static r:Testi.SpiegazionePrezziVoce}" />
        <CheckBox IsChecked="{Binding Attiva}" Content="{x:Static r:Testi.VoceAttiva}" IsVisible="{Binding InModifica}" />

        <StackPanel>
          <TextBlock Classes="etichetta">
            <Run Text="{x:Static r:Testi.Note}" />
            <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{DynamicResource TestoSecondario}" />
          </TextBlock>
          <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" AutomationProperties.Name="{x:Static r:Testi.Note}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
