<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.EditorImpiantoView"
             x:DataType="vm:EditorImpiantoViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <TextBlock Text="{Binding Titolo}" FontSize="20" FontWeight="Bold" />
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" IsDefault="True" Content="{x:Static r:Testi.SalvaImpianto}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24" Spacing="20">
        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <DockPanel>
            <Path Classes="icona" Data="{StaticResource IconaAvviso}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Errore}" />
          </DockPanel>
        </Border>

        <Grid ColumnDefinitions="2*,16,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.TipoImpianto}" />
            <ComboBox ItemsSource="{Binding Tipi}" SelectedItem="{Binding Tipo}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.TipoImpianto}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.ColStato}" />
            <ComboBox ItemsSource="{Binding Stati}" SelectedItem="{Binding Stato}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.ColStato}" />
          </StackPanel>
        </Grid>

        <StackPanel IsVisible="{Binding ConDismissione}">
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.DismessoIl}" />
          <CalendarDatePicker SelectedDate="{Binding DismessoIl}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.DismessoIl}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*,16,2*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.AnnoInstallazione}" />
            <TextBox Text="{Binding Anno}" MaxLength="4" AutomationProperties.Name="{x:Static r:Testi.AnnoInstallazione}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.PotenzaUtileKw}" />
            <TextBox Text="{Binding Potenza}" AutomationProperties.Name="{x:Static r:Testi.PotenzaUtileKw}" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Combustibile}" />
            <ComboBox ItemsSource="{Binding Combustibili}" SelectedItem="{Binding Combustibile}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.Combustibile}" />
          </StackPanel>
        </Grid>

        <StackPanel>
          <TextBlock Classes="etichetta">
            <Run Text="{x:Static r:Testi.Pdr}" />
            <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{DynamicResource TestoSecondario}" />
          </TextBlock>
          <TextBox Text="{Binding Pdr}" AutomationProperties.Name="{x:Static r:Testi.Pdr}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="etichetta">
            <Run Text="{x:Static r:Testi.ManutenzioneOgniMesi}" />
            <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{DynamicResource TestoSecondario}" />
          </TextBlock>
          <TextBox Text="{Binding ManutenzioneMesi}" MaxLength="3" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static r:Testi.ManutenzioneOgniMesi}" />
          <TextBlock Classes="secondario" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" Text="{x:Static r:Testi.SpiegazioneManutenzioneMesi}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Proprietario}" />
            <ComboBox ItemsSource="{Binding Clienti}" SelectedItem="{Binding Proprietario}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.Proprietario}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Responsabile}" />
            <ComboBox ItemsSource="{Binding Clienti}" SelectedItem="{Binding Responsabile}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.Responsabile}" />
          </StackPanel>
        </Grid>
        <DockPanel IsVisible="{Binding PuoCercareClienti}">
          <Button DockPanel.Dock="Right" Classes="secondario" Margin="12,0,0,0" Content="{x:Static r:Testi.Cerca}" Command="{Binding CercaClienteCommand}" />
          <TextBox Text="{Binding RicercaCliente}" PlaceholderText="{x:Static r:Testi.CercaAltroCliente}" AutomationProperties.Name="{x:Static r:Testi.CercaAltroCliente}" />
        </DockPanel>

        <StackPanel>
          <TextBlock Classes="etichetta">
            <Run Text="{x:Static r:Testi.Note}" />
            <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{DynamicResource TestoSecondario}" />
          </TextBlock>
          <TextBox Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="{x:Static r:Testi.Note}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
