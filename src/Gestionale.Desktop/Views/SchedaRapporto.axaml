<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.SchedaRapportoView"
             x:DataType="vm:SchedaRapportoViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">
      <StackPanel Spacing="12">
        <Button Classes="collegamento" HorizontalAlignment="Left" Content="{x:Static r:Testi.TornaAiRapporti}" Command="{Binding IndietroCommand}" />
        <DockPanel>
          <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" MaxWidth="720" HorizontalAlignment="Right">
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.SalvaBozza}" Command="{Binding SalvaCommand}"
                    IsVisible="{Binding PuoModificare}" IsEnabled="{Binding !InCorso}" />
            <Button Classes="primario" Margin="0,0,8,8" Content="{x:Static r:Testi.Convalida}" Command="{Binding ConvalidaCommand}"
                    IsVisible="{Binding PuoConvalidare}" IsEnabled="{Binding !InCorso}" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.Riapri}" Command="{Binding RiapriCommand}"
                    IsVisible="{Binding PuoRiaprire}" IsEnabled="{Binding !InCorso}" />
            <Button Classes="primario" Margin="0,0,8,8" Content="{x:Static r:Testi.Firma}" Command="{Binding FirmaCommand}"
                    IsVisible="{Binding PuoFirmare}" IsEnabled="{Binding !InCorso}" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.ApriImpianto}" Command="{Binding ApriImpiantoCommand}" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.ApriIntervento}" Command="{Binding ApriInterventoCommand}" IsVisible="{Binding HaIntervento}" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.AnnullaRapporto}" Foreground="{DynamicResource Errore}"
                    Command="{Binding AnnullaCommand}" IsVisible="{Binding PuoAnnullare}" />
          </WrapPanel>
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="titolo2" Text="{Binding Titolo}" />
              <Border Classes="distintivo">
                <TextBlock Text="{Binding Stato}" />
              </Border>
            </StackPanel>
            <TextBlock FontSize="14" Text="{Binding Sottotitolo}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <TextBlock Text="{Binding Errore}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="avvisoSuccesso" IsVisible="{Binding HaAvviso}">
          <TextBlock Text="{Binding Avviso}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="avvisoAttenzione" IsVisible="{Binding TermineVicino}">
          <TextBlock Text="{Binding Termine}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="avvisoAttenzione" IsVisible="{Binding Annullamento, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Annullamento}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="avvisoErrore" IsVisible="{Binding HaErroriGenerali}">
          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="{x:Static r:Testi.ErroriDaCorreggere}" />
            <ItemsControl ItemsSource="{Binding ErroriGenerali}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="avvisoAttenzione" IsVisible="{Binding HaAvvisi}">
          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="{x:Static r:Testi.AvvisiRapporto}" />
            <ItemsControl ItemsSource="{Binding Avvisi}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="2*,20,*">
        <!-- Il modulo: una voce per colonna del tracciato con origine "dati" -->
        <Border Grid.Column="0" Classes="scheda">
          <StackPanel>
            <TextBlock Classes="titoloSezione" Margin="20,12" Text="{x:Static r:Testi.DatiDelControllo}" />
            <Border Height="1" Background="{DynamicResource Divisore}" />
            <ItemsControl ItemsSource="{Binding Campi}" Margin="20,8,20,16">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CampoModulo">
                  <StackPanel Margin="0,8">
                    <TextBlock Classes="etichetta" Text="{Binding Etichetta}" />
                    <TextBox Text="{Binding Testo}" IsVisible="{Binding ConTesto}" MaxLength="{Binding Lunghezza}"
                             AcceptsReturn="{Binding Lungo}" TextWrapping="Wrap"
                             IsReadOnly="{Binding $parent[UserControl].((vm:SchedaRapportoViewModel)DataContext).SolaLettura}"
                             PlaceholderText="{Binding Suggerimento}" AutomationProperties.Name="{Binding Etichetta}" />
                    <ComboBox ItemsSource="{Binding Opzioni}" SelectedItem="{Binding Scelta}" IsVisible="{Binding ConOpzioni}" MinWidth="240"
                              IsEnabled="{Binding $parent[UserControl].((vm:SchedaRapportoViewModel)DataContext).PuoModificare}"
                              AutomationProperties.Name="{Binding Etichetta}" />
                    <CalendarDatePicker SelectedDate="{Binding Data}" IsVisible="{Binding ConData}" MinWidth="200"
                                        IsEnabled="{Binding $parent[UserControl].((vm:SchedaRapportoViewModel)DataContext).PuoModificare}"
                                        AutomationProperties.Name="{Binding Etichetta}" />
                    <TextBlock FontSize="13" Foreground="{DynamicResource Errore}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{Binding Errore}" IsVisible="{Binding HaErrore}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Spacing="20">
          <Border Classes="scheda" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.Controllo}" />
              <StackPanel>
                <TextBlock Classes="etichetta" Text="{x:Static r:Testi.DataControllo}" />
                <CalendarDatePicker SelectedDate="{Binding DataControllo}" IsEnabled="{Binding PuoModificare}" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{x:Static r:Testi.DataControllo}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Dati}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CampoScheda">
                    <StackPanel Margin="0,4">
                      <TextBlock Classes="secondario" FontSize="12" Text="{Binding Etichetta}" />
                      <TextBlock FontSize="14" Text="{Binding Valore}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="scheda" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.BollinoRegionale}" />
              <TextBlock FontSize="14" Text="{Binding Bollino}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primario" Content="{x:Static r:Testi.AssegnaBollino}" Command="{Binding AssegnaBollinoCommand}" IsVisible="{Binding PuoAssegnareBollino}" />
                <Button Classes="secondario" Content="{x:Static r:Testi.LiberaBollino}" Command="{Binding LiberaBollinoCommand}"
                        IsVisible="{Binding PuoLiberareBollino}" IsEnabled="{Binding !InCorso}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="secondario" FontSize="13" TextWrapping="Wrap" Text="{x:Static r:Testi.DisclaimerRapporto}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
