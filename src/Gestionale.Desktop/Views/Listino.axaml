<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.ListinoView"
             x:DataType="vm:ListinoViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primario" VerticalAlignment="Center" Content="{x:Static r:Testi.NuovaVoce}"
                Command="{Binding NuovaVoceCommand}" IsVisible="{Binding GestisceListino}" />
        <StackPanel>
          <TextBlock Classes="titolo2" Text="{x:Static r:Testi.ListinoTitolo}" />
          <TextBlock Classes="secondario" FontSize="14" Margin="0,4,0,0" Text="{Binding Conteggio}" />
        </StackPanel>
      </DockPanel>

      <DockPanel>
        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding AncheDisattivate}" Content="{x:Static r:Testi.AncheDisattivate}" />
        <TextBox Text="{Binding Testo}" MaxWidth="420" HorizontalAlignment="Left" Margin="0,0,16,0"
                 PlaceholderText="{x:Static r:Testi.CercaListino}" AutomationProperties.Name="{x:Static r:Testi.CercaListino}" />
      </DockPanel>

      <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
        <TextBlock Text="{Binding Errore}" />
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondario" Content="{x:Static r:Testi.Precedente}" IsEnabled="{Binding PuoPrecedente}" Command="{Binding PrecedenteCommand}" />
        <Button Classes="secondario" Content="{x:Static r:Testi.Successiva}" IsEnabled="{Binding PuoSuccessiva}" Command="{Binding SuccessivaCommand}" />
      </StackPanel>
      <TextBlock Classes="secondario" FontSize="14" VerticalAlignment="Center" Text="{Binding Intervallo}" />
    </DockPanel>

    <Border Classes="scheda">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="1.2*,3*,1.2*,70,2*,80,Auto" Margin="16,12">
          <TextBlock Grid.Column="0" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColCodice}" />
          <TextBlock Grid.Column="1" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColDescrizione}" />
          <TextBlock Grid.Column="2" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColTipo}" />
          <TextBlock Grid.Column="3" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.Unita}" />
          <TextBlock Grid.Column="4" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColPrezzo}" />
          <TextBlock Grid.Column="5" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.Iva}" />
          <Border Grid.Column="6" Width="180" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Bordo}" />
        <Panel>
          <TextBlock Classes="secondario" FontSize="14" Margin="16,24" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding Vuoto}" Text="{x:Static r:Testi.NessunaVoce}" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Righe}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RigaVoce">
                  <Border BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid ColumnDefinitions="1.2*,3*,1.2*,70,2*,80,Auto">
                      <TextBlock Grid.Column="0" Classes="codice" FontSize="13" Text="{Binding Codice}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Descrizione}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Classes="distintivo" IsVisible="{Binding Disattivata}">
                          <TextBlock Text="{x:Static r:Testi.Disattivata}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Tipo}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Unita}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Prezzo}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="5" Text="{Binding Iva}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="6" Width="180" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsVisible="{Binding $parent[UserControl].((vm:ListinoViewModel)DataContext).GestisceListino}">
                        <Button Classes="collegamento" Content="{x:Static r:Testi.Modifica}"
                                Command="{Binding $parent[UserControl].((vm:ListinoViewModel)DataContext).ModificaVoceCommand}" CommandParameter="{Binding}" />
                        <Button Classes="collegamento" Content="{x:Static r:Testi.NuovoPrezzo}"
                                Command="{Binding $parent[UserControl].((vm:ListinoViewModel)DataContext).NuovoPrezzoCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
