<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.SchedaPreventivoView"
             x:DataType="vm:SchedaPreventivoViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">
      <StackPanel Spacing="12">
        <Button Classes="collegamento" HorizontalAlignment="Left" Content="{x:Static r:Testi.TornaAiPreventivi}" Command="{Binding IndietroCommand}" />
        <DockPanel>
          <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" MaxWidth="720" HorizontalAlignment="Right">
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.ScaricaPdf}" Click="ScaricaPdf_Click" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.Modifica}" Command="{Binding ModificaCommand}" IsVisible="{Binding PuoModificare}" />
            <Button Classes="primario" Margin="0,0,8,8" Content="{x:Static r:Testi.Emetti}" Command="{Binding EmettiCommand}" IsVisible="{Binding PuoModificare}" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.Elimina}" Foreground="{DynamicResource Errore}"
                    Command="{Binding EliminaCommand}" IsVisible="{Binding PuoModificare}" />
            <Button Classes="primario" Margin="0,0,8,8" Content="{x:Static r:Testi.SegnaAccettato}" Command="{Binding AccettaCommand}" IsVisible="{Binding PuoRispondere}" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.SegnaRifiutato}" Command="{Binding RifiutaCommand}" IsVisible="{Binding PuoRispondere}" />
            <Button Classes="primario" Margin="0,0,8,8" Content="{x:Static r:Testi.GeneraIntervento}" Command="{Binding GeneraInterventoCommand}" IsVisible="{Binding PuoGenerareIntervento}" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.ApriIntervento}" Command="{Binding ApriInterventoCommand}" IsVisible="{Binding HaIntervento}" />
            <Button Classes="secondario" Margin="0,0,8,8" Content="{x:Static r:Testi.AnnullaPreventivo}" Foreground="{DynamicResource Errore}"
                    Command="{Binding AnnullaCommand}" IsVisible="{Binding PuoAnnullare}" />
          </WrapPanel>
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="titolo2" Text="{Binding Titolo}" />
              <Border Classes="distintivo" Classes.inScadenza="{Binding Scaduto}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Classes="icona" Data="{StaticResource IconaAvviso}" Width="12" Height="12" IsVisible="{Binding Scaduto}" />
                  <TextBlock Text="{Binding Stato}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock FontSize="14" Text="{Binding Oggetto}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <TextBlock Text="{Binding Errore}" />
        </Border>
        <Border Classes="avvisoSuccesso" IsVisible="{Binding HaAvviso}">
          <DockPanel>
            <Path Classes="icona" Data="{StaticResource IconaOk}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Avviso}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
        <Border Classes="avvisoAttenzione" IsVisible="{Binding Scaduto}">
          <DockPanel>
            <Path Classes="icona" Data="{StaticResource IconaAvviso}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{x:Static r:Testi.AvvisoPreventivoScaduto}" />
          </DockPanel>
        </Border>
        <Border Classes="avvisoAttenzione" IsVisible="{Binding Annullamento, Converter={x:Static ObjectConverters.IsNotNull}}">
          <DockPanel>
            <Path Classes="icona" Data="{StaticResource IconaInfo}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Annullamento}" />
          </DockPanel>
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="2*,20,*">
        <StackPanel Grid.Column="0" Spacing="20">
          <!-- Voci con i totali calcolati dal server -->
          <Border Classes="scheda">
            <StackPanel>
              <TextBlock Classes="titoloSezione" Margin="20,12" Text="{x:Static r:Testi.VociPreventivo}" />
              <Border Height="1" Background="{DynamicResource Divisore}" />
              <TextBlock Classes="secondario" FontSize="14" Margin="20,16" IsVisible="{Binding SenzaRighe}" Text="{x:Static r:Testi.NessunaRiga}" />
              <ItemsControl ItemsSource="{Binding Righe}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RigaMostrata">
                    <Border BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="20,10">
                      <Grid ColumnDefinitions="100,*,90,90,60,100">
                        <TextBlock Grid.Column="0" Classes="secondario" FontSize="13" Text="{Binding Tipo}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="14" Text="{Binding Descrizione}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" FontSize="14" Text="{Binding Quantita}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" FontSize="14" Text="{Binding Prezzo}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Classes="secondario" FontSize="13" Text="{Binding Sconto}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" FontSize="14" FontWeight="SemiBold" Text="{Binding Importo}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto,120" RowDefinitions="Auto,Auto,Auto" Margin="20,12">
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="secondario" FontSize="14" Text="{x:Static r:Testi.Imponibile}" />
                <TextBlock Grid.Row="0" Grid.Column="2" FontSize="14" Text="{Binding Imponibile}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="secondario" FontSize="14" Text="{x:Static r:Testi.Iva}" />
                <TextBlock Grid.Row="1" Grid.Column="2" FontSize="14" Text="{Binding Iva}" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Text="{x:Static r:Testi.Totale}" />
                <TextBlock Grid.Row="2" Grid.Column="2" FontSize="15" FontWeight="SemiBold" Text="{Binding Totale}" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="scheda" Padding="20,16" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.Note}" />
              <SelectableTextBlock FontSize="14" Text="{Binding Note}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="20">
          <Border Classes="scheda" Padding="20,16">
            <StackPanel Spacing="8">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.ColCliente}" />
              <Button Classes="collegamento" Padding="0" HorizontalAlignment="Left" Content="{Binding Cliente}" Command="{Binding ApriClienteCommand}" IsVisible="{Binding PuoAprireCliente}" />
              <TextBlock FontSize="14" Text="{Binding Cliente}" IsVisible="{Binding !PuoAprireCliente}" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Luogo, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Path Classes="icona" Data="{StaticResource IconaLuogo}" Width="16" Height="16" VerticalAlignment="Center" />
                <SelectableTextBlock FontSize="14" Text="{Binding Luogo}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Classes="secondario" FontSize="13" Text="{Binding Impianto}" IsVisible="{Binding Impianto, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>

          <Border Classes="scheda" Padding="20,16">
            <StackPanel Spacing="12">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.DettagliPreventivo}" />
              <ItemsControl ItemsSource="{Binding Dati}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CampoScheda">
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Classes="secondario" FontSize="12" Text="{Binding Etichetta}" />
                      <SelectableTextBlock FontSize="14" Text="{Binding Valore}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
