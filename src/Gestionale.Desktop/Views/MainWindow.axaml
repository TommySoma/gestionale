<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gestionale.Desktop.ViewModels"
        xmlns:r="using:Gestionale.Desktop.Risorse"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
        x:Class="Gestionale.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1024" Height="640"
        Title="{x:Static r:Testi.TitoloApplicazione}">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <TextBlock Text="{Binding Messaggio}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />
</Window>
