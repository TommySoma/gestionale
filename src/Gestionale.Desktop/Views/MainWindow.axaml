<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gestionale.Desktop.ViewModels"
        xmlns:r="using:Gestionale.Desktop.Risorse"
        x:Class="Gestionale.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Title="{x:Static r:Testi.TitoloApplicazione}">
  <ContentControl Content="{Binding Pagina}" />
</Window>
