<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.EditorConsensoView"
             x:DataType="vm:EditorConsensoViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <TextBlock Text="{x:Static r:Testi.TitoloRegistraConsenso}" FontSize="20" FontWeight="Bold" />
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" IsDefault="True" Content="{x:Static r:Testi.SalvaConsenso}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24" Spacing="20">
      <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
        <TextBlock Text="{Binding Errore}" />
      </Border>
      <StackPanel>
        <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Finalita}" />
        <ComboBox ItemsSource="{Binding Finalita}" SelectedItem="{Binding FinalitaScelta}" AutomationProperties.Name="{x:Static r:Testi.Finalita}" />
      </StackPanel>
      <CheckBox IsChecked="{Binding Concesso}" Content="{x:Static r:Testi.ConsensoConcesso}" />
      <StackPanel>
        <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Fonte}" />
        <ComboBox ItemsSource="{Binding Fonti}" SelectedItem="{Binding Fonte}" AutomationProperties.Name="{x:Static r:Testi.Fonte}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="etichetta">
          <Run Text="{x:Static r:Testi.Note}" />
          <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{DynamicResource TestoSecondario}" />
        </TextBlock>
        <TextBox Text="{Binding Note}" AutomationProperties.Name="{x:Static r:Testi.Note}" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</UserControl>
