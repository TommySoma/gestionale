<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.EditorInterventoView"
             x:DataType="vm:EditorInterventoViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <TextBlock Text="{Binding Titolo}" FontSize="20" FontWeight="Bold" />
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" IsDefault="True" Content="{x:Static r:Testi.Salva}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24" Spacing="20">
        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <DockPanel>
            <Path Classes="icona" Data="{StaticResource IconaAvviso}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Errore}" />
          </DockPanel>
        </Border>

        <StackPanel>
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Impianto}" />
          <ComboBox ItemsSource="{Binding Impianti}" SelectedItem="{Binding Impianto}" HorizontalAlignment="Stretch" IsEnabled="{Binding !ImpiantoFisso}"
                    PlaceholderText="{x:Static r:Testi.ScegliImpianto}" AutomationProperties.Name="{x:Static r:Testi.Impianto}" />
          <DockPanel Margin="0,8,0,0" IsVisible="{Binding !ImpiantoFisso}">
            <Button DockPanel.Dock="Right" Classes="secondario" Margin="8,0,0,0" Content="{x:Static r:Testi.Cerca}" Command="{Binding CercaImpiantoCommand}" />
            <TextBox Text="{Binding RicercaImpianto}" PlaceholderText="{x:Static r:Testi.CercaImpianti}" AutomationProperties.Name="{x:Static r:Testi.CercaImpianti}" />
          </DockPanel>
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.TipoIntervento}" />
          <ComboBox ItemsSource="{Binding Tipi}" SelectedItem="{Binding Tipo}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.TipoIntervento}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="etichetta">
            <Run Text="{x:Static r:Testi.DescrizioneIntervento}" />
            <Run Text="{x:Static r:Testi.Facoltativo}" FontWeight="Normal" Foreground="{DynamicResource TestoSecondario}" />
          </TextBlock>
          <TextBox Text="{Binding Descrizione}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="{x:Static r:Testi.DescrizioneIntervento}" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Quando}" />
          <TextBlock Classes="secondario" FontSize="13" TextWrapping="Wrap" Text="{x:Static r:Testi.SpiegazioneDaPianificare}" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="collegamento" Margin="8,0,0,0" Content="{x:Static r:Testi.TogliData}" Command="{Binding TogliDataCommand}" IsVisible="{Binding ConData}" />
            <CalendarDatePicker SelectedDate="{Binding Data}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.Data}" />
          </DockPanel>
          <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding ConData}">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="etichetta" Text="{x:Static r:Testi.OraInizio}" />
              <TimePicker SelectedTime="{Binding OraInizio}" ClockIdentifier="24HourClock" MinuteIncrement="15" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Static r:Testi.OraInizio}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="etichetta" Text="{x:Static r:Testi.OraFine}" />
              <TimePicker SelectedTime="{Binding OraFine}" ClockIdentifier="24HourClock" MinuteIncrement="15" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Static r:Testi.OraFine}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Tecnico}" />
          <ComboBox ItemsSource="{Binding Tecnici}" SelectedItem="{Binding Tecnico}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.Tecnico}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
