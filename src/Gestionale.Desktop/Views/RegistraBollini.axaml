<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.RegistraBolliniView"
             x:DataType="vm:RegistraBolliniViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="24,20">
      <TextBlock Text="{x:Static r:Testi.RegistraBollini}" FontSize="20" FontWeight="Bold" />
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divisore}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Classes="secondario" IsCancel="True" Content="{x:Static r:Testi.Annulla}" Command="{Binding AnnullaCommand}" />
        <Button Classes="primario" Content="{x:Static r:Testi.RegistraBollini}" Command="{Binding SalvaCommand}" IsEnabled="{Binding !InCorso}" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24" Spacing="20">
        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <TextBlock Text="{Binding Errore}" TextWrapping="Wrap" />
        </Border>
        <TextBlock FontSize="14" TextWrapping="Wrap" Text="{x:Static r:Testi.SpiegazioneRegistraBollini}" />
        <Grid ColumnDefinitions="2*,16,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.TipoBollino}" />
            <ComboBox ItemsSource="{Binding Tipi}" SelectedItem="{Binding Tipo}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.TipoBollino}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="etichetta" Text="{x:Static r:Testi.DataAcquisto}" />
            <CalendarDatePicker SelectedDate="{Binding AcquistatoIl}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:Testi.DataAcquisto}" />
          </StackPanel>
        </Grid>
        <StackPanel>
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.CodiciBollini}" />
          <TextBox Text="{Binding Codici}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                   AutomationProperties.Name="{x:Static r:Testi.CodiciBollini}" />
          <TextBlock Classes="secondario" FontSize="13" Margin="0,4,0,0" Text="{Binding ConteggioCodici}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="etichetta" Text="{x:Static r:Testi.Note}" />
          <TextBox Text="{Binding Note}" MaxLength="500" AutomationProperties.Name="{x:Static r:Testi.Note}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
