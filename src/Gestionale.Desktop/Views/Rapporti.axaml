<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.RapportiView"
             x:DataType="vm:RapportiViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Classes="titolo2" Text="{x:Static r:Testi.RapportiTitolo}" />
        <TextBlock Classes="secondario" FontSize="14" Margin="0,4,0,0" Text="{Binding Conteggio}" />
      </StackPanel>

      <WrapPanel Orientation="Horizontal">
        <ToggleButton Classes="filtro" Margin="0,0,8,8" Content="{x:Static r:Testi.FiltroTutti}" IsChecked="{Binding FiltroTutti}" />
        <ToggleButton Classes="filtro" Margin="0,0,8,8" Content="{x:Static r:Testi.FiltroBozze}" IsChecked="{Binding FiltroBozze}" />
        <ToggleButton Classes="filtro" Margin="0,0,8,8" Content="{x:Static r:Testi.FiltroConvalidati}" IsChecked="{Binding FiltroConvalidati}" />
        <ToggleButton Classes="filtro" Margin="0,0,8,8" Content="{x:Static r:Testi.FiltroDaTrasmettere}" IsChecked="{Binding FiltroDaTrasmettere}" />
        <ToggleButton Classes="filtro" Margin="0,0,8,8" Content="{x:Static r:Testi.FiltroTrasmessi}" IsChecked="{Binding FiltroTrasmessi}" />
        <ToggleButton Classes="filtro" Margin="0,0,8,8" Content="{x:Static r:Testi.FiltroScartati}" IsChecked="{Binding FiltroScartati}" />
      </WrapPanel>

      <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
        <TextBlock Text="{Binding Errore}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondario" Content="{x:Static r:Testi.Precedente}" IsEnabled="{Binding PuoPrecedente}" Command="{Binding PrecedenteCommand}" />
        <Button Classes="secondario" Content="{x:Static r:Testi.Successiva}" IsEnabled="{Binding PuoSuccessiva}" Command="{Binding SuccessivaCommand}" />
      </StackPanel>
      <TextBlock Classes="secondario" FontSize="14" VerticalAlignment="Center" Text="{Binding Intervallo}" />
    </DockPanel>

    <Border Classes="scheda">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="1.3*,2*,2.4*,0.8*,1.4*,1.4*,Auto" Margin="16,12">
          <TextBlock Grid.Column="0" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColDataControllo}" />
          <TextBlock Grid.Column="1" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColCliente}" />
          <TextBlock Grid.Column="2" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColLuogo}" />
          <TextBlock Grid.Column="3" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColModello}" />
          <TextBlock Grid.Column="4" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColBollino}" />
          <TextBlock Grid.Column="5" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColTermine}" />
          <TextBlock Grid.Column="6" Classes="secondario" FontSize="12" FontWeight="SemiBold" Text="{x:Static r:Testi.ColStato}" Width="110" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Bordo}" />
        <Panel>
          <TextBlock Classes="secondario" FontSize="14" Margin="16,24" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding Vuoto}" Text="{x:Static r:Testi.NessunRapporto}" />
          <ListBox ItemsSource="{Binding Righe}" Background="Transparent" AutomationProperties.Name="{x:Static r:Testi.RapportiTitolo}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RigaElencoRapporto">
                <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" MinHeight="44"
                        Command="{Binding $parent[UserControl].((vm:RapportiViewModel)DataContext).ApriCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="1.3*,2*,2.4*,0.8*,1.4*,1.4*,Auto" Margin="4,0">
                    <TextBlock Grid.Column="0" Text="{Binding Data}" FontWeight="SemiBold" Foreground="{DynamicResource Accento}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Cliente}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Luogo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Modello}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Bollino}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Path Classes="icona" Data="{StaticResource IconaAvviso}" Width="12" Height="12" Stroke="{DynamicResource Errore}" IsVisible="{Binding TermineVicino}" />
                      <TextBlock Text="{Binding Termine}" />
                    </StackPanel>
                    <Border Grid.Column="6" Classes="distintivo" Width="110" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Stato}" HorizontalAlignment="Center" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
