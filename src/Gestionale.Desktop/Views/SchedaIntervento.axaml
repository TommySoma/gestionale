<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gestionale.Desktop.ViewModels"
             xmlns:r="using:Gestionale.Desktop.Risorse"
             x:Class="Gestionale.Desktop.Views.SchedaInterventoView"
             x:DataType="vm:SchedaInterventoViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">
      <StackPanel Spacing="12">
        <Button Classes="collegamento" HorizontalAlignment="Left" Content="{x:Static r:Testi.Indietro}" Command="{Binding IndietroCommand}" />
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button Classes="primario" Content="{x:Static r:Testi.AvviaIntervento}" Command="{Binding AvviaCommand}" IsVisible="{Binding PuoAvviare}" />
            <Button Classes="primario" Content="{x:Static r:Testi.ChiudiIntervento}" Command="{Binding ChiudiCommand}" IsVisible="{Binding PuoChiudere}" />
            <Button Classes="secondario" Content="{x:Static r:Testi.Pianifica}" Command="{Binding PianificaCommand}" IsVisible="{Binding PuoPianificare}" />
            <Button Classes="secondario" Content="{x:Static r:Testi.AnnullaIntervento}" Foreground="{DynamicResource Errore}"
                    Command="{Binding AnnullaInterventoCommand}" IsVisible="{Binding PuoAnnullare}" />
          </StackPanel>
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="titolo2" Text="{Binding Titolo}" />
              <Border Classes="distintivo">
                <TextBlock Text="{Binding Stato}" />
              </Border>
            </StackPanel>
            <TextBlock FontSize="14" Text="{Binding Sottotitolo}" />
          </StackPanel>
        </DockPanel>

        <Border Classes="avvisoErrore" IsVisible="{Binding HaErrore}">
          <TextBlock Text="{Binding Errore}" />
        </Border>
        <Border Classes="avvisoAttenzione" IsVisible="{Binding Annullato}">
          <DockPanel>
            <Path Classes="icona" Data="{StaticResource IconaInfo}" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Annullamento}" />
          </DockPanel>
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="2*,20,*">
        <StackPanel Grid.Column="0" Spacing="20">
          <!-- Dove: impianto e indirizzo -->
          <Border Classes="scheda" Padding="20,16">
            <StackPanel Spacing="8">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.Impianto}" />
              <Button Classes="collegamento" Padding="0" HorizontalAlignment="Left" Content="{Binding Impianto}" Command="{Binding ApriImpiantoCommand}" IsVisible="{Binding PuoAprireImpianto}" />
              <TextBlock FontSize="14" Text="{Binding Impianto}" IsVisible="{Binding !PuoAprireImpianto}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icona" Data="{StaticResource IconaLuogo}" Width="16" Height="16" VerticalAlignment="Center" />
                <SelectableTextBlock FontSize="14" Text="{Binding Indirizzo}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="secondario" FontSize="12" Margin="0,8,0,0" Text="{x:Static r:Testi.DescrizioneIntervento}"
                         IsVisible="{Binding Descrizione, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <SelectableTextBlock FontSize="14" Text="{Binding Descrizione}" TextWrapping="Wrap"
                                   IsVisible="{Binding Descrizione, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>

          <!-- Materiali e ore, dopo la chiusura -->
          <Border Classes="scheda" IsVisible="{Binding Chiuso}">
            <StackPanel>
              <DockPanel Margin="20,12">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
          <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static r:Testi.Totale}" />
          <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Totale}" />
        </StackPanel>
                <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.MaterialiEOre}" VerticalAlignment="Center" />
              </DockPanel>
              <Border Height="1" Background="{DynamicResource Divisore}" />
              <TextBlock Classes="secondario" FontSize="14" Margin="20,16" IsVisible="{Binding SenzaRighe}" Text="{x:Static r:Testi.NessunaRiga}" />
              <ItemsControl ItemsSource="{Binding Righe}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RigaMostrata">
                    <Border BorderBrush="{DynamicResource Divisore}" BorderThickness="0,0,0,1" Padding="20,10">
                      <Grid ColumnDefinitions="100,*,90,90,60,100">
                        <TextBlock Grid.Column="0" Classes="secondario" FontSize="13" Text="{Binding Tipo}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="14" Text="{Binding Descrizione}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" FontSize="14" Text="{Binding Quantita}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" FontSize="14" Text="{Binding Prezzo}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Classes="secondario" FontSize="13" Text="{Binding Sconto}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" FontSize="14" FontWeight="SemiBold" Text="{Binding Importo}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="20">
          <Border Classes="scheda" Padding="20,16">
            <StackPanel Spacing="12">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.DettagliIntervento}" />
              <ItemsControl ItemsSource="{Binding Dati}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CampoScheda">
                    <StackPanel Margin="0,0,0,12">
                      <TextBlock Classes="secondario" FontSize="12" Text="{Binding Etichetta}" />
                      <SelectableTextBlock FontSize="14" Text="{Binding Valore}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="scheda" Padding="20,16" IsVisible="{Binding Chiuso}">
            <StackPanel Spacing="8">
              <TextBlock Classes="titoloSezione" Text="{x:Static r:Testi.Esito}" />
              <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Esito}" />
              <SelectableTextBlock FontSize="14" Text="{Binding NoteChiusura}" TextWrapping="Wrap"
                                   IsVisible="{Binding NoteChiusura, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
