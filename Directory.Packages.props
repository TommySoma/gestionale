<Project>
  <!-- Gestione centralizzata delle versioni: controlla la licenza prima di aggiungere un pacchetto. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Desktop (MIT)">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Codici QR senza dipendenze (QRCoder richiede System.Drawing.Common, solo Windows). -->
    <PackageVersion Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup Label="Database (DbUp: MIT, Npgsql: PostgreSQL License, Dapper: Apache 2.0)">
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
    <PackageVersion Include="Npgsql" Version="10.0.4" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
  </ItemGroup>

  <ItemGroup Label="Sicurezza (tutti MIT)">
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Posta (MailKit e MimeKit: MIT)">
    <PackageVersion Include="MailKit" Version="4.18.2" />
  </ItemGroup>
  <ItemGroup Label="Documenti (SkiaSharp: MIT)">
    <!-- PDF dei documenti generati dall'API (ADR 0005). Stessa versione usata da Avalonia. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <!-- Libreria nativa per il server Linux; senza fontconfig: i caratteri sono incorporati. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup Label="Test (xUnit: Apache 2.0, Testcontainers: MIT, Avalonia.Headless: MIT)">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <!-- Disegna le viste senza finestra. Non Avalonia.Headless.XUnit: è compilato per xUnit v3 3.x. -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <!-- Rilegge il testo dei PDF generati, solo nei test (Apache 2.0). -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
