# Copia questo file in deploy/.env e sostituisci i valori. deploy/.env non va mai nel repository.
# Le password sono usate solo al primo avvio, quando il volume del database è vuoto.
POSTGRES_PASSWORD=cambia-questa-password-superutente
APP_OWNER_PASSWORD=cambia-questa-password-owner
APP_API_PASSWORD=cambia-questa-password-api
APP_CHATBOT_PASSWORD=cambia-questa-password-chatbot
# Porta sul computer locale (il database ascolta solo su 127.0.0.1); 15432 per non scontrarsi con un PostgreSQL già installato, fuori dagli intervalli che Windows riserva a Hyper-V.
DB_PORTA=15432
# API nel container (profilo "api"): chiavi Base64 di 32 byte, generate da scripts/sviluppo/avvia.ps1.
API_CHIAVE_FIRMA=genera-una-chiave-base64-di-32-byte
API_CHIAVE_CIFRATURA_MFA=genera-una-chiave-base64-di-32-byte
# Token per il primo avvio (POST /api/installazione); lascialo vuoto dopo l'installazione.
API_TOKEN_INSTALLAZIONE=
# Porta dell'API sul computer locale.
API_PORTA=5225
